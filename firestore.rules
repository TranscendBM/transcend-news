rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 創見新聞監控 — Firestore 安全規則
// 原則：前端實際讀取的集合開放「公開唯讀」；所有客戶端一律禁止寫入。
// 寫入僅由 Admin SDK 執行——正式排程為 Cloud Functions（transcend-news-tbm
// 專案的 functions/main.py），GitHub Actions 僅保留手動備援觸發。
// Admin SDK 繞過規則，因此 write: false 只擋客戶端，不影響排程。
//
// 內部集合 meta/*（排程鎖 lock_*、去重索引分片 newsIndex_0..f）、
// ai_jobs/*、ai_insights/* 一律不在下面明確列出的公開唯讀集合裡，
// 由檔末的預設拒絕涵蓋：客戶端不可讀寫，僅 Admin SDK 存取。
//
// job_status/* 例外：這是專為前端「系統健康」頁面準備的公開摘要集合
// （見 functions/main.py 的 _run_locked、functions/ai_worker_health.py），
// 內容只有排程成敗時間戳記與錯誤字串、ai_jobs 待處理筆數等彙總資訊，
// 不含任何內部集合的原始資料，可安全公開唯讀。
//
// 部署位置：transcend-news-tbm（見 docs/firestore-migration/README.md
// 的遷移歷史記錄）。這份規則檔案本身不含專案 ID，firebase.json 的
// "firestore" 區塊已指向這個檔案，Rules 與 Indexes 已部署到
// transcend-news-tbm。
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // 新聞（前端以 collection query 讀取）
    match /news/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    // 即時股價（前端讀 stocks/latest 單一文件，並以 onSnapshot 監聽）
    match /stocks/latest {
      allow read: if true;
      allow write: if false;
    }

    // 月營收（前端讀 revenue/2451 與競品 3260/8271/4967/5289/4973）
    match /revenue/{stockCode} {
      allow read: if true;
      allow write: if false;
    }

    // 季度損益（前端讀 financials/2451）
    match /financials/{stockCode} {
      allow read: if true;
      allow write: if false;
    }

    // 股利（前端讀 dividends/2451）
    match /dividends/{stockCode} {
      allow read: if true;
      allow write: if false;
    }

    // 競品重大訊息（前端讀 material/competitors 單一文件）
    match /material/competitors {
      allow read: if true;
      allow write: if false;
    }

    // 每日交易資料（前端讀 daily/2451）
    match /daily/{stockCode} {
      allow read: if true;
      allow write: if false;
    }

    // 排程健康狀態摘要（前端「系統健康」頁面讀取，見上方說明）
    match /job_status/{jobName} {
      allow read: if true;
      allow write: if false;
    }

    // 人工確認媒體曝光：僅公開去除內部備註後的資料。
    // 原始檔名、來源列號與採訪備註放在 media_exposure_private，未在此
    // 明確開放，會由下方預設規則拒絕所有客戶端讀寫。
    match /media_exposure/{exposureId} {
      allow read: if true;
      allow write: if false;
    }

    // 其他未列出的集合一律拒絕（讀＋寫）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
