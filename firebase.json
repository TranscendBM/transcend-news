{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python311",
      "ignore": ["venv", "__pycache__", ".git", "*.local"]
    }
  ],
  "hosting": [
    {
      "target": "main",
      "public": "dist",
      "rewrites": [
        {
          "source": "/api/media-exposure",
          "function": { "functionId": "upload_media_exposure", "region": "asia-east1" }
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "old",
      "public": "redirect",
      "redirects": [
        {
          "source": "**",
          "destination": "https://transcend-news.web.app",
          "type": 301
        }
      ]
    }
  ]
}
